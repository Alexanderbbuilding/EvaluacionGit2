Algoritmo ejercio2FredyRincon
	escribir " señor usuario ingrese el numero a verificar"
	leer NumVerificar
	NumVerificado<-NumVerificar % 2
	Si NumVerificado = 0 Entonces
		Escribir "Señor usuario su numero es par"
	SiNo
		Escribir "señor usuario su numero no es par"
	Fin Si
FinAlgoritmo

