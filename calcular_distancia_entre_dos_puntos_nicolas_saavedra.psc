Algoritmo calcular_distancia_entre_dos_puntos
	Escribir 'punto de partida (metros)'
	Leer punto_inicio
	Escribir 'punto de finalizacion (metros)'
	Leer punto_final
	Escribir 'La distancia entre sus dos puntos es:'
	distancia_entre_puntos<- (punto_final-punto_inicio)
	Escribir distancia_entre_puntos,'m'
FinAlgoritmo
