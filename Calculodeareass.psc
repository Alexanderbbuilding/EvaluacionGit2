Algoritmo sin_titulo
	Escribir "Ingrese los cm de la base de un triangulo:"
	Leer a1
	Escribir "Ingrese los cm de la altura del triangulo:"
	Leer a2
	resultado<-a1*a2/2
	Escribir "El area del triangulo es: " (resultado)
FinAlgoritmo

