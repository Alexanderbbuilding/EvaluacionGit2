
	Algoritmo Ejercicio6
		Definir Num1, i, AcumuladorNumero Como Entero
		
		Escribir "ingrese el numero al que desea obtener el factorial"
		Leer num1
		
		AcumuladorNumero <- 1
		
		Para i <- 1 Hasta num1 Con Paso 1 Hacer
			AcumuladorNumero <- AcumuladorNumero * i
		FinPara
		
		Escribir " el factorial de ", Num1 , " es ", AcumuladorNumero
		
FinAlgoritmo

