Algoritmo sin_titulo
	Definir GradosCelsius, GradosFarenheit Como Real
	
	Escribir "Ingrese los grados Celsius:"
	Leer GradosCelsius
	
	GradosFarenheit <- (GradosCelsius * 9/5) + 32
	
	Escribir "Los grados Fahrenheit son: ", GradosFarenheit
FinAlgoritmo
